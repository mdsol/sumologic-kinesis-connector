{
  "version": 2,
  "release": {
    "commands": []
  },
  "deploy": {
    "tasks": [
      {
        "name": "worker",
        "type": "service",
        "command": "java -jar /home/app/worker/target/kinesis-sumologic-connector-0.2.jar use-env",
        "listening_ports": [],
        "max_ram": 2048
      }
    ],
    "deploy_tasks": [
      {
        "name": "worker"
      }
    ]
  },
  "config": {
    "schema": {
