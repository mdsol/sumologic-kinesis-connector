      "required": [
        "AWS_DEFAULT_REGION",
        "appName",
        "regionName",
        "retryLimit",
        "backoffInterval",
        "bufferRecordCountLimit",
        "bufferMillisecondsLimit",
        "kinesisInputStream",
        "createKinesisInputStream",
