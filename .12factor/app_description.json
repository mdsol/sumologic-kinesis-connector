        },
        "kinesisInputStream": {
          "type": "string"
        },
        "createKinesisInputStream": {
          "type": "boolean"
        },
        "createKinesisOutputStream": {
          "type": "boolean"
        },
        "transformerClass": {
          "type": "string"
        },
        "connectorDestination": {
          "type": "string"
        },
        "sumologicUrl": {
          "type": "string"
        }
